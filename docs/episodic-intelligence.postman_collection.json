{
  "info": {
    "name": "Episodic Intelligence API",
    "description": "Full API collection with auto-populating variables.\n\nWorkflow: Run GET /api/projects first (or POST /api/generate-core) to auto-set projectId, versionId, and episodeId for all subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "projectId", "value": "" },
    { "key": "versionId", "value": "" },
    { "key": "episodeId", "value": "" },
    { "key": "secondVersionId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Setup & Bootstrap",
      "description": "Run these first to populate collection variables.",
      "item": [
        {
          "name": "POST /api/generate-core",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('projectId', body.project_id);",
                  "  pm.collectionVariables.set('versionId', body.version_id);",
                  "  console.log('Auto-set projectId=' + body.project_id + ', versionId=' + body.version_id);",
                  "}",
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Has project_id', () => pm.expect(pm.response.json().project_id).to.be.a('string'));",
                  "pm.test('Has version_id', () => pm.expect(pm.response.json().version_id).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Neon Detective\",\n  \"input_type\": \"idea\",\n  \"raw_story\": \"A cyberpunk detective discovers a body that looks exactly like him in a rain-soaked alley. The body wears his exact face, carries his wallet, and has a message tattooed on its arm: RUN.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/generate-core",
              "host": ["{{baseUrl}}"],
              "path": ["api", "generate-core"]
            }
          }
        },
        {
          "name": "GET /api/projects (auto-set IDs from first project)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.projects && body.projects.length > 0) {",
                  "    const p = body.projects[0];",
                  "    pm.collectionVariables.set('projectId', p.id);",
                  "    if (p.active_version_id) pm.collectionVariables.set('versionId', p.active_version_id);",
                  "    console.log('Auto-set projectId=' + p.id + ', versionId=' + p.active_version_id);",
                  "  }",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has projects array', () => pm.expect(pm.response.json().projects).to.be.an('array'));",
                  "pm.test('Has pagination', () => pm.expect(pm.response.json().pagination).to.have.property('total'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "GET /api/projects/:id (auto-set episodeId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.version_data && body.version_data.episodes && body.version_data.episodes.length > 0) {",
                  "    pm.collectionVariables.set('episodeId', body.version_data.episodes[0].id);",
                  "    console.log('Auto-set episodeId=' + body.version_data.episodes[0].id);",
                  "  }",
                  "  if (body.active_version_id) pm.collectionVariables.set('versionId', body.active_version_id);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has version_data', () => pm.expect(pm.response.json().version_data).to.be.an('object'));",
                  "pm.test('Has episodes', () => pm.expect(pm.response.json().version_data.episodes).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Projects CRUD",
      "item": [
        {
          "name": "GET /api/projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has projects array', () => pm.expect(pm.response.json().projects).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "GET /api/projects/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has title', () => pm.expect(pm.response.json().title).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        },
        {
          "name": "PATCH /api/projects/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Title updated', () => pm.expect(pm.response.json().title).to.eql('Updated Series Title'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Series Title\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        },
        {
          "name": "DELETE /api/projects/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "{{projectId}}"]
            }
          }
        }
      ]
    },
