          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"{{projectId}}\",\n  \"target_version_id\": \"{{versionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rollback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rollback"]
            }
