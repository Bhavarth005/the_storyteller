        {
          "name": "GET /api/versions/compare",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has deltas', () => pm.expect(pm.response.json().deltas).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/versions/compare?base_id={{versionId}}&target_id={{secondVersionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "versions", "compare"],
              "query": [
                { "key": "base_id", "value": "{{versionId}}" },
                { "key": "target_id", "value": "{{secondVersionId}}" }
              ]
            }
          }
        },
        {
          "name": "POST /api/rollback",
          "event": [
